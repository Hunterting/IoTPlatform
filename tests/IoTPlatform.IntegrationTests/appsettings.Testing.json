{
  "_comment": [
    "集成测试专用配置。由 TestWebAppFactory 从测试程序集输出目录显式加载（主工程 ContentRoot 下没有这个文件）。",
    "ConnectionStrings:TestMySql 只是【占位说明】，默认留空：",
    "  · 真正的测试库连接串优先从环境变量 IOT_TEST_MYSQL 读取；",
    "  · 其次读本文件的 ConnectionStrings:TestMySql；",
    "  · 最后回退到仓库根 appsettings.json 的 ConnectionStrings:DefaultConnection（仅取服务器/账号，Database 会被替换成一次性 schema）。",
    "禁止把明文账号密码提交到本文件——请用环境变量。",
    "示例（PowerShell）: $env:IOT_TEST_MYSQL = 'Server=192.168.3.7;Port=3306;User=root;Password=<凭据>;'"
  ],
  "ConnectionStrings": {
    "TestMySql": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning"
    }
  },
  "Redis": {
    "ConnectionString": "127.0.0.1:1,defaultDatabase=0,abortConnect=false,connectTimeout=200",
    "Enabled": false
  },
  "DataRetention": {
    "Enabled": false,
    "InitialDelayMinutes": 100000
  },
  "MQTT": {
    "Server": "127.0.0.1",
    "Port": 1,
    "Username": "test",
    "Password": "test"
  },
  "AnShengMqtt": {
    "Host": "127.0.0.1",
    "Port": 1,
    "Username": "test",
    "Password": "test",
    "ClientIdPrefix": "iot_platform_ansheng_test",
    "AutoConfigureAutoReport": false
  }
}
